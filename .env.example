# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syllabus_aggregator
POSTGRES_PORT=5432

# Backend API Configuration
API_PORT=4000
PORT=4000 # Backend listen port (read by the API; dock-compose sets PORT from API_PORT)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syllabus_aggregator?schema=public # Required when running the backend outside Docker (docker-compose builds it from the POSTGRES_* vars)

JWT_SECRET=dev-secret-change-me

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000 # Frontend → backend base URL (used by frontend/src/lib/http.ts)